<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="800" Height="400"
        x:Class="AvaloniaApplication1.MainWindow"
        Title="AvaloniaApplication1">
        <ScrollViewer>
                <StackPanel>
                        <TextBlock HorizontalAlignment="Left">Input pcap FilePath:</TextBlock>
                        <TextBox HorizontalAlignment="Left" Name="InputedFilePath" Width="800" Height="15"/>
                        <Button HorizontalAlignment="Left" Content="Load File" Click="MyButton_Clicked"/>
                        <TextBlock HorizontalAlignment="Left" Name="MyTextBox" TextWrapping="Wrap"> File Content...</TextBlock>
                </StackPanel>
        </ScrollViewer>
</Window>

